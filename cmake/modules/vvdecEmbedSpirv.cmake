# Writes the SPIR-V modules of the Vulkan shaders into one C++ header.
#
#   cmake -DOUTPUT=<header> -DNAMES=<name,name,...> -DDIR=<directory of the .spv files> -P vvdecEmbedSpirv.cmake
#
# Each module <name>.spv becomes `static const uint32_t kSpirv_<name>[]`, and the
# header ends with the ShaderId enumeration and a table, both in the order of NAMES.

string( REPLACE "," ";" NAMES "${NAMES}" )

set( _text "// Generated by cmake/modules/vvdecEmbedSpirv.cmake from source/Lib/VulkanLib/shaders.\n#pragma once\n#include <cstdint>\n#include <cstddef>\n\nnamespace vvdec\n{\nnamespace gpu\n{\n\n" )

foreach( _name IN LISTS NAMES )
  file( READ "${DIR}/${_name}.spv" _hex HEX )
  string( LENGTH "${_hex}" _length )
  math( EXPR _remainder "${_length} % 8" )
  if( NOT _remainder EQUAL 0 OR _length EQUAL 0 )
    message( FATAL_ERROR "${DIR}/${_name}.spv is not a SPIR-V module" )
  endif()
  # little-endian bytes to 32-bit words
  string( REGEX REPLACE "([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])" "0x\\4\\3\\2\\1," _words "${_hex}" )
  string( REGEX REPLACE "((0x[0-9a-f]+,){12})" "\\1\n  " _words "${_words}" )
  string( APPEND _text "static const uint32_t kSpirv_${_name}[] = {\n  ${_words}\n};\n\n" )
endforeach()

string( APPEND _text "enum ShaderId\n{\n" )
foreach( _name IN LISTS NAMES )
  string( APPEND _text "  kShader_${_name},\n" )
endforeach()
string( APPEND _text "  kShaderCount\n};\n\nstruct ShaderCode\n{\n  const char*     name;\n  const uint32_t* words;\n  size_t          size;\n};\n\nstatic const ShaderCode kShaders[kShaderCount] = {\n" )
foreach( _name IN LISTS NAMES )
  string( APPEND _text "  { \"${_name}\", kSpirv_${_name}, sizeof( kSpirv_${_name} ) },\n" )
endforeach()
string( APPEND _text "};\n\n}   // namespace gpu\n}   // namespace vvdec\n" )

file( WRITE "${OUTPUT}" "${_text}" )
